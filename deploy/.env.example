# Copy to deploy/.env (next to docker-compose.yml) and adjust. Never commit the real .env.
# Variables are documented in docs/ARCHITECTURE.md ("Configuration") and docs/DEPLOYMENT.md.

# Image tag produced by `nix build .#dockerImage` (= version in backend/build.gradle.kts).
YNAY_VERSION=0.1.0

# Host interface/port to publish. Use 127.0.0.1 when a reverse proxy on this host terminates TLS.
YNAY_BIND=127.0.0.1
YNAY_HOST_PORT=8080

# --- Database (the bundled postgres service is created with these credentials) ---
YNAY_DB_USER=ynay
# Generate with: openssl rand -base64 32
YNAY_DB_PASSWORD=change-me

# --- Public origin (OIDC redirect URI, MCP metadata). Must match what browsers use. ---
YNAY_PUBLIC_URL=https://ynay.example.com

# --- Kanidm (OIDC login) — see deploy/kanidm/ ---
YNAY_KANIDM_URL=https://idm.example.com
YNAY_KANIDM_CLIENT_ID=ynay
# kanidm system oauth2 show-basic-secret ynay
YNAY_KANIDM_CLIENT_SECRET=change-me
# Also accept Kanidm access tokens on /mcp (RFC 7662 introspection).
#YNAY_MCP_INTROSPECTION=false

# --- Import agent (optional; disabled without an API key) ---
#YNAY_AGENT_PROVIDER=anthropic
#YNAY_AGENT_API_KEY=
#YNAY_AGENT_MODEL=
# OpenAI-compatible local server, e.g. Ollama:
#YNAY_AGENT_PROVIDER=openai
#YNAY_AGENT_BASE_URL=http://ollama:11434/v1

# --- JVM ---
# Extra JVM flags (read by the java launcher), e.g. a heap cap or a truststore for a private CA:
#JDK_JAVA_OPTIONS=-Xmx512m -Djavax.net.ssl.trustStore=/certs/truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit
